# Neo4j Desktop runs on the Mac host. Docker reaches it through this hostname.
# When uvicorn runs directly on the host, main.py rewrites this to
# bolt://127.0.0.1:7687 automatically because host.docker.internal only
# resolves inside a container.
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-local-password

# Database inside the DBMS that holds the BioLens graph. It must be online.
NEO4J_DATABASE=biolens

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional tuning
# LOG_LEVEL=INFO
# NEO4J_CONNECTION_TIMEOUT=10
# NEO4J_MAX_POOL_SIZE=50
