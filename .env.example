# Docker Compose mode secrets for the fully containerised stack.
# Copy this file to .env and set your real Neo4j password:
#   cp .env.example .env
# Then keep it in sync with biolens-backend/.env (used when the backend runs
# directly on the host instead of in Docker).
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-local-password
NEO4J_DATABASE=biolens
